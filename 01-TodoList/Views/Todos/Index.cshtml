@model TodoListViewModel
@{
    ViewData["Title"] = "Tareas";
    var pending = Model.Items.Count(i => !i.IsCompleted);
}

<h1 class="h3 mb-3">Mis tareas <span class="badge bg-secondary">@pending pendientes</span></h1>

<form asp-action="Create" method="post" class="row g-2 mb-4">
    <div class="col">
        <input asp-for="NewItem.Title" class="form-control" placeholder="¿Qué hay que hacer?" autocomplete="off" />
        <span asp-validation-for="NewItem.Title" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Agregar tarea</button>
    </div>
</form>

@if (!Model.Items.Any())
{
    <p class="text-muted">Aún no hay tareas. Agrega la primera arriba.</p>
}
else
{
    <ul class="list-group">
        @foreach (var item in Model.Items)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <form asp-action="Toggle" asp-route-id="@item.Id" method="post" class="d-flex align-items-center gap-2 mb-0">
                    <input type="checkbox" class="form-check-input mt-0" checked="@item.IsCompleted" onchange="this.form.submit()" />
                    <span class="@(item.IsCompleted ? "text-decoration-line-through text-muted" : "")">@item.Title</span>
                </form>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="mb-0">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                </form>
            </li>
        }
    </ul>
}
