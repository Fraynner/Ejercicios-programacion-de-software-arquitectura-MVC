@model List<Category>
@{
    ViewData["Title"] = "Categorías";
}

<h1 class="h3 mb-3">Categorías</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<form asp-action="Create" method="post" class="row g-2 mb-4">
    <div class="col"><input name="Name" class="form-control" placeholder="Nombre de la nueva categoría" maxlength="50" required /></div>
    <div class="col-auto"><button class="btn btn-primary">Agregar</button></div>
</form>

<ul class="list-group">
    @foreach (var c in Model)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            @c.Name
            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="mb-0">
                <button class="btn btn-sm btn-outline-danger">Eliminar</button>
            </form>
        </li>
    }
</ul>
