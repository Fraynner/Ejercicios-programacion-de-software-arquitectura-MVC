<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Calendario de eventos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Events" asp-action="Index">Calendario de eventos</a>
            <div class="d-flex gap-3 align-items-center"><button id="enableNotifications" type="button" class="btn btn-sm btn-outline-light">Activar notificaciones</button></div>
        </div>
    </nav>
    <main class="container pb-5">
        @RenderBody()
    </main>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/localization/messages_es.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <div id="toastArea" class="position-fixed top-0 end-0 p-3" style="z-index: 1080;"></div>
    <script>
        (function () {
            const button = document.getElementById('enableNotifications');
            if ('Notification' in window && Notification.permission === 'granted') {
                button.style.display = 'none';
            }
            button.addEventListener('click', function () {
                if ('Notification' in window) {
                    Notification.requestPermission().then(function () { button.style.display = 'none'; });
                }
            });

            function showToast(text) {
                const div = document.createElement('div');
                div.className = 'alert alert-warning alert-dismissible shadow';
                div.innerHTML = '<strong>Recordatorio:</strong> ' + text +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
                div.querySelector('.btn-close').addEventListener('click', function () { div.remove(); });
                document.getElementById('toastArea').appendChild(div);
                setTimeout(function () { div.remove(); }, 20000);
            }

            async function checkReminders() {
                try {
                    const response = await fetch('/Events/Upcoming');
                    const events = await response.json();
                    events.forEach(function (e) {
                        const key = 'notified-' + e.id + '-' + e.start;
                        if (localStorage.getItem(key)) return;
                        localStorage.setItem(key, '1');

                        const text = e.title + ' empieza en ' + e.minutesLeft + ' min';
                        showToast(text);
                        if ('Notification' in window && Notification.permission === 'granted') {
                            new Notification('Recordatorio de evento', { body: text });
                        }
                    });
                } catch (err) { /* ignore network errors */ }
            }

            checkReminders();
            setInterval(checkReminders, 30000);
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
