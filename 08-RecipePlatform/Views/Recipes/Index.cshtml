@model RecipeIndexViewModel
@{
    ViewData["Title"] = "Recetas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Recetas</h1>
    <a asp-action="Create" class="btn btn-primary">+ Compartir una receta</a>
</div>

<form method="get" asp-action="Index" class="card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Nombre</label>
            <input name="search" value="@Model.Search" class="form-control" placeholder="ej. pasta" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Tipo de comida</label>
            <select name="mealType" class="form-select">
                <option value="">Todos los tipos</option>
                @foreach (var t in Enum.GetValues<MealType>())
                {
                    <option value="@t" selected="@(Model.MealType == t)">@t.GetDisplayName()</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Ingredientes (separados por coma)</label>
            <input name="ingredients" value="@Model.Ingredients" class="form-control" placeholder="ej. huevo, leche" />
        </div>
        <div class="col-md-1">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="savedOnly" value="true" id="savedOnly" checked="@Model.SavedOnly" />
                <label class="form-check-label" for="savedOnly">Guardadas</label>
            </div>
        </div>
        <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Filtrar</button></div>
    </div>
</form>

@if (!Model.Recipes.Any())
{
    <p class="text-muted">Ninguna receta coincide con los filtros.</p>
}
<div class="row g-3">
    @foreach (var r in Model.Recipes)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5"><a asp-action="Details" asp-route-id="@r.Id" class="text-decoration-none">@r.Title</a></h2>
                    <span class="badge bg-info text-dark">@r.MealType.GetDisplayName()</span>
                    <span class="badge bg-light text-dark border">@r.PrepMinutes min</span>
                    <p class="small text-muted mt-2 mb-0">@(string.Join(", ", r.IngredientList.Take(4)) + (r.IngredientList.Count() > 4 ? "..." : ""))</p>
                </div>
                <div class="card-footer bg-white">
                    <form asp-action="ToggleSaved" asp-route-id="@r.Id" method="post" class="mb-0">
                        <button class="btn btn-sm @(r.IsSaved ? "btn-warning" : "btn-outline-warning")">@(r.IsSaved ? "★ Guardada" : "☆ Guardar")</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
