@model List<SurveyListItem>
@{
    ViewData["Title"] = "Encuestas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Encuestas</h1>
    <a asp-action="Create" class="btn btn-primary">+ Crear encuesta</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Aún no hay encuestas. ¡Crea la primera!</p>
}
<div class="row g-3">
    @foreach (var item in Model)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">@item.Survey.Title</h2>
                    <p class="text-muted">@item.Survey.Description</p>
                    <span class="badge bg-secondary">@item.ResponseCount respuestas</span>
                </div>
                <div class="card-footer bg-white d-flex gap-2">
                    <a asp-action="Respond" asp-route-id="@item.Survey.Id" class="btn btn-sm btn-primary">Responder</a>
                    <a asp-action="Results" asp-route-id="@item.Survey.Id" class="btn btn-sm btn-outline-success">Resultados</a>
                    <a asp-action="Manage" asp-route-id="@item.Survey.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <form asp-action="Delete" asp-route-id="@item.Survey.Id" method="post" class="ms-auto mb-0" onsubmit="return confirm('¿Eliminar esta encuesta y todas sus respuestas?');">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
